local function offerAll()
    findTradeServices()
    if not (tradeClient and tradeCore) then
        task.wait(1)
        findTradeServices()
    end
    local useVerify = tradeClient ~= nil
    local fails = {}
    if not tradeCore then
        fails[#fails + 1] = "TradeServiceCore not found  -  offering without a whitelist check"
    end
    if not useVerify then
        fails[#fails + 1] = "TradeServiceClient not found  -  no verification"
    end
    local function tryOffer(remote, ...)
        if useVerify and yourOffers() then
            local before = #yourOffers()
            local ok, err = pcall(EC.invoke_server, remote, ...)
            if not ok then return false, tostring(err) end
            local t0 = tick()
            while yourOffers() and #yourOffers() == before and (tick() - t0) < 1.5 do
                task.wait(0.1)
            end
            local now = yourOffers()
            return (now and #now or before) > before
        else
            local ok, err = pcall(EC.invoke_server, remote, ...)
            if not ok then return false, tostring(err) end
            task.wait(1.5)
            return true
        end
    end
    local unitsList = {}
    for uuid, u in pairs(ownedUnits()) do
        if unitTradeable(u) then
            local info = unitInfo[u.unit_id] or {}
            unitsList[#unitsList + 1] = { uuid = wrapUuid(uuid), rarity = info.rarity or "Common" }
        end
    end
    table.sort(unitsList, function(a, b)
        local ra, rb = RARITY_TIERS[a.rarity] or 0, RARITY_TIERS[b.rarity] or 0
        if ra ~= rb then return ra > rb end
        return a.uuid < b.uuid
    end)
    local n_units, n_uniq, n_norm = 0, 0, 0
    local function slots() return TRADE_MAX - (n_units + n_uniq + n_norm) end
    if TRADE_UNITS_ON then
        for _, entry in ipairs(unitsList) do
            if slots() <= 0 then break end
            local ok, err = tryOffer("offer_unit", entry.uuid)
            if ok then n_units += 1; task.wait(1)
            else fails[#fails + 1] = "offer_unit(" .. entry.uuid .. "): " .. tostring(err or "rejected") end
        end
    end
    for _, entry in ipairs(uniqueItems()) do
        if slots() <= 0 then break end
        if uniqueTradeable(entry) then
            local ok, err = tryOffer("offer_unique_item", wrapUuid(entry.uuid))
            if ok then n_uniq += 1; task.wait(1)
            else fails[#fails + 1] = "offer_unique_item(" .. tostring(entry.item_id) .. "): " .. tostring(err or "rejected") end
        end
    end
    local normalIds = {}
    for id in pairs(normalItems()) do normalIds[#normalIds + 1] = id end
    table.sort(normalIds)
    for _, id in ipairs(normalIds) do
        if slots() <= 0 then break end
        if normalTradeable(id) then
            local count = tonumber(normalItems()[id]) or 1
            local ok, err = tryOffer("offer_normal_item", id, count)
            if ok then n_norm += 1; task.wait(1)
            else fails[#fails + 1] = "offer_normal_item(" .. tostring(id) .. "): " .. tostring(err or "rejected") end
        end
    end
    return n_units, n_uniq, n_norm, fails
end
