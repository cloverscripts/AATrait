    if type(v) == "table" then
        for _, k in ipairs({ "player", "from", "sender", "user", "Player", "From" }) do
            local c = rawget(v, k)
            if typeof(c) == "Instance" and c:IsA("Player") then return c end
        end
        for _, c in pairs(v) do
            if typeof(c) == "Instance" and c:IsA("Player") then return c end
        end
    end
    if type(v) == "string" then return Players:FindFirstChild(v) end
    if type(v) == "number" then return Players:GetPlayerByUserId(v) end
    return nil
end
