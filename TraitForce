local function scheduleNextRound()
    local partner = trade.partner
    trade.roundToken += 1
    local token = trade.roundToken
    if not (partner and partner.Parent) then
        setStatus("no partner left  -  chain stopped")
        return
    end
    setStatus(string.format("trade %d done  -  next in %ds", trade.round, ROUND_DELAY))
    task.delay(ROUND_DELAY, function()
        if token ~= trade.roundToken then return end
        if not trade.armed or trade.inTrade then return end
        if not partner.Parent then
            setStatus("partner left  -  chain stopped")
            trade.partner = nil
            return
        end
        if trade.lastOffered <= 0 then
            setStatus("last round landed no offers  -  chain stopped")
            return
        end
        if trade.round >= MAX_ROUNDS then
            setStatus(string.format("round cap (%d) reached  -  chain stopped", MAX_ROUNDS))
            return
        end
        local left = sendableCount()
        if left <= 0 then
            setStatus(string.format("done  -  %d trade(s), nothing left to send", trade.round))
            postWebhook("trade chain finished",
                string.format("%d trade(s) with %s", trade.round, partner.Name), 5763719,
                { { name = "hunter", value = partner.Name, inline = true } })
            return
        end
        setStatus(string.format("starting trade %d  -  %d offer(s) queued", trade.round + 1, left))
        requestTrade(partner)
    end)
end
