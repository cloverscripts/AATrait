local ROMAN = { I = 1, II = 2, III = 3, IV = 4, V = 5 }
local odds, oddsTotal = {}, 0
local function loadOdds()
    odds, oddsTotal = {}, 0
    for _, row in ipairs(ui.TraitChancesScroll:GetChildren()) do
        if row.Name == "TraitChanceFrame" then
            local nameL = row:FindFirstChild("TraitName", true)
            local chanceL = row:FindFirstChild("Chance", true)
            if nameL and chanceL then
                local name = nameL.Text:gsub("<[^>]+>", "")
                local pct = tonumber((chanceL.Text:gsub("<[^>]+>", ""):match("([%d%.]+)")))
                local base, roman = name:match("^(.-)%s+([IV]+)$")
                base = (base or name):lower()
                local id = idByName[base]
                if id and pct then
                    oddsTotal += pct
                    odds[#odds + 1] = { id = id, tier = roman and ROMAN[roman] or 1, w = pct }
                end
            end
        end
    end
end
loadOdds()
local function pickTraits(forceUnique)
    if forceUnique then return { { trait = "unique", tier = 1 } } end
    if oddsTotal <= 0 then loadOdds() end
    local r = math.random() * oddsTotal
    for _, o in ipairs(odds) do
        r -= o.w
        if r <= 0 then return { { trait = o.id, tier = o.tier } } end
    end
    return { { trait = odds[#odds].id, tier = odds[#odds].tier } }
end
