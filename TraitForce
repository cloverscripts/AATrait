local function makeDraggable(handle, target, onTap, onMoved)
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, moved = true, false
            dragStart = input.Position
            startPos = target.Position
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local d = input.Position - dragStart
        if math.abs(d.X) + math.abs(d.Y) > 5 then moved = true end
        local nx = math.clamp(startPos.X.Offset + d.X, 0, vp.X - target.AbsoluteSize.X)
        local ny = math.clamp(startPos.Y.Offset + d.Y, 0, vp.Y - target.AbsoluteSize.Y)
        target.Position = UDim2.fromOffset(nx, ny)
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = false
        if moved then
            if onMoved then onMoved(target.Position) end
        elseif onTap then
            onTap()
        end
    end))
end
